# Environment and secrets
.env
.env.*
!.env.example
auth.json
*.pem
*.key

# PHP dependencies and local tools
/vendor/
/composer.phar
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
/coverage/

# JavaScript dependencies and test output
/node_modules/
/.npm/
/playwright-report/
