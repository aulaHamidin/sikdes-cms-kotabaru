/writable/cache/**
/writable/debugbar/**
/writable/logs/**
/writable/session/**
/writable/uploads/**
/writable/private/**
!/writable/**/.gitkeep

# Private operational files
/storage/private/**
/storage/imports/**
/storage/exports/**
/storage/reports/**
/storage/backups/**
